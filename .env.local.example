# Ключи API для генерации арта (scripts/art-gen.mjs).
# Скопируйте этот файл в .env.local (в той же папке) и впишите свои ключи после «=»,
# без кавычек и пробелов. Файл .env.local в git не попадает.
# Пустой ключ — этот сервис просто пропускается.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# xAI Grok — https://console.x.ai  (раздел API Keys)
XAI_API_KEY=

# OpenAI GPT Image — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Необязательно: другие модели, если по умолчанию недоступны
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# XAI_IMAGE_MODEL=grok-imagine-image
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
